# Copy this template to .env beside pyproject.toml for a fresh local setup.
# python -m spintails loads that project file at startup; restart after edits.
# Existing environment variables take precedence. Values are read literally.
# Settings key changes apply only to the current session and do not edit .env.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SPINTAILS_DATA_DIR=.spintails
# SPINTAILS_PORT=8765
