# Copy this template to .env beside pyproject.toml for a fresh local setup.
# python -m bardic loads that project file at startup; restart after edits.
# Existing environment variables take precedence. Values are read literally.
# Settings key changes apply only to the current session and do not edit .env.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Defaults to .bardic, or reuses an existing .spintails directory in place.
# BARDIC_DATA_DIR=/absolute/path/to/library
# BARDIC_PORT=8765
# Opt-in access from other devices as http://bardic.local:PORT. No login:
# anyone on the network can use the library and these keys.
# BARDIC_LAN_NAME=bardic
# Existing SPINTAILS_DATA_DIR and SPINTAILS_PORT are still accepted.
