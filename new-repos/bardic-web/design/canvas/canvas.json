  },
  "s0": {
   "x": 0,
   "y": 300,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "blue",
   "text": "Bardic v2\nThree tabs: Home, Library, Settings. A book has audiobooks (one voice each). Play works at once with a free voice; everything else is opt-in."
  },
  "t1": {
   "kind": "title1",
   "text": "Listeners",
   "x": 540,
   "y": 1560,
   "maxW": 4954,
   "w": 240
  },
  "s1": {
   "x": 0,
   "y": 1820,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "green",
   "text": "Listeners\nA dropdown, no password. Places and finished marks are per listener; everything else is shared."
  },
  "t2": {
   "kind": "title1",
   "text": "Home and Library",
   "x": 540,
   "y": 2800,
   "maxW": 7148,
   "w": 240
  },
  "s2": {
   "x": 0,
   "y": 3060,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "orange",
   "text": "Home and Library\nHome is Continue, on this device and recent. Library is every book. A download badge marks books on this device."
  },
  "t3": {
   "kind": "title1",
   "text": "Book and audiobooks",
   "x": 540,
   "y": 4040,
   "maxW": 4014,
   "w": 240
  },
  "s3": {
   "x": 0,
   "y": 4300,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "purple",
   "text": "Book page\nThe audiobook card is the centre: which voice, how much is ready, how much is on this device. Make ready and Download are its two verbs."
  },
  "t4": {
   "kind": "title1",
   "text": "Make it ready and offline",
   "x": 540,
   "y": 5280,
   "maxW": 2740,
   "w": 240
  },
  "s4": {
   "x": 0,
   "y": 5540,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "blue",
   "text": "Plans and offline\nPaid work is one plan with a limit you approve. Downloads are per device; away from home, downloaded chapters still play."
  },
  "t5": {
   "kind": "title1",
   "text": "Listen and read",
   "x": 540,
   "y": 6520,
   "maxW": 6262,
   "w": 240
  },
  "s5": {
   "x": 0,
   "y": 6780,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "purple",
   "text": "Listen and read\nUnchanged from v1 in structure. Status is reduced to four words."
  },
  "t6": {
   "kind": "title1",
   "text": "Reader sheets",
   "x": 540,
   "y": 8040,
   "maxW": 4014,
   "w": 240
  },
  "s6": {
   "x": 0,
   "y": 8300,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "green",
   "text": "Reader sheets\nUnchanged from v1 apart from vocabulary: Ready, Making, Not yet."
  },
  "t7": {
   "kind": "title1",
   "text": "Settings",
   "x": 540,
   "y": 9280,
   "maxW": 3210,
   "w": 240
  },
  "s7": {
   "x": 0,
   "y": 9540,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "orange",
   "text": "Settings\nVoices (free, premium, your own server), Allowance, Downloads. Keys and limits live one level down."
  },
  "t8": {
   "kind": "title1",
   "text": "Edge states and recovery",
   "x": 540,
   "y": 10520,
   "maxW": 7910,
   "w": 240
  },
  "s8": {
   "x": 0,
   "y": 10780,
   "w": 440,
   "maxH": 560,
   "size": 24,
   "fill": "red",
   "text": "Edge states\nWhat happens when it goes wrong: no voice, a rejected key, an Allowance that is too low, a failed or out-of-date download. Each says what is kept."
  }
